# Copy to .env and fill in. NEVER commit a filled .env.

# Port to listen on (hosting platforms usually inject PORT).
PORT=8080
# Registered handler path — register this exact path on the dashboard.
AGENT_PATH=/agent

# Platform-issued HMAC secret: dashboard -> your agent -> Rotate Secret.
# Shown exactly once. No default; the server refuses to start without it.
AGENT_GAMES_HMAC_SECRET=

# Directory holding gatekeeper.wasm, gatekeeper_final.zkey, gatekeeper_vk.json.
# Default: ./circuits
CIRCUIT_DIR=
# Directory for the persistent task store. Default: ./data
DATA_DIR=

# Optional: Upstash Redis REST (Vercel KV). When BOTH are set, the task
# store lives in KV instead of the local file — required on serverless,
# where the filesystem is ephemeral. Create via the Vercel dashboard's
# Storage tab (Upstash integration); Vercel injects these automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# How task_id is encoded as a circuit field element (keccak|sha256|ascii|hex-digits).
# Unconfirmed by the platform; settle via practice mode. Default: keccak
TASK_ID_ENCODING=keccak

# Optional: Kurier mainnet API key for on-chain anchoring of proofs.
KURIER_API_KEY=

# Proving budget per task (ms) and margin kept before deadline_at (ms).
PROOF_BUDGET_MS=45000
DEADLINE_MARGIN_MS=3000

# Optional direct TLS (normally the host terminates TLS).
TLS_KEY_PATH=
TLS_CERT_PATH=
